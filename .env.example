# ============================================================
# CTEV Bot — Template de Variáveis de Ambiente
# ============================================================
# Copie este arquivo para `.env` e preencha com seus valores reais.
#   cp .env.example .env
# NUNCA versione o arquivo .env (já está no .gitignore).
# ============================================================

# ---- Telegram ----
# Crie um bot com @BotFather e use o token abaixo
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Para obter o chat_id: mande uma msg pro bot e acesse
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=-1001234567890

# ---- Binance (API) ----
# Crie em https://www.binance.com/en/my/settings/api-management
# Para apenas LEITURA de dados públicos de candle, as chaves são opcionais,
# mas recomendadas para evitar rate-limit mais agressivo.
BINANCE_API_KEY=sua_api_key_aqui
BINANCE_API_SECRET=sua_api_secret_aqui

# ---- Par de trading e timeframe ----
BINANCE_SYMBOL=BTC/USDT
BINANCE_TIMEFRAME=1h

# ---- Loop ----
LOOP_INTERVAL_SECONDS=60

# ---- Logging ----
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ============================================================
# RISK MANAGER (v2.0) — Gerenciamento de Risco
# ============================================================

# Max drawdown diário (%). Se perda >= este valor em 24h UTC, bot pausa.
MAX_DAILY_LOSS_PCT=5.0

# Max drawdown semanal (%). Se perda >= este valor em 7 dias, bot pausa.
MAX_WEEKLY_LOSS_PCT=10.0

# Max perdas consecutivas antes de pausa automática (cooldown).
MAX_CONSECUTIVE_LOSSES=5

# Circuit Breaker: se preço mover X% em 1 candle, bot pausa imediatamente.
CIRCUIT_BREAKER_PCT=3.0

# Mínimo de candles entre sinais (evita overtrading).
COOLDOWN_CANDLES=3

# Horas de pausa após perdas consecutivas atingirem o limite.
COOLDOWN_HOURS=12

# ---- Filtro de Volatilidade (ATR Percentile) ----
# Só gera sinais se ATR(14) está entre estes percentis (0.0 a 1.0).
# Fora desta faixa = mercado muito lateral (baixo) ou muito caótico (alto).
ATR_PCT_MIN=0.20
ATR_PCT_MAX=0.80

# ============================================================
# POSITION SIZING & TRAILING (v2.1)
# ============================================================

# Saldo da conta em USD (usado para calculo de tamanho de posicao)
ACCOUNT_BALANCE=10000.0

# Percentual do balance arriscado por trade (default 1%)
# QuantVPS: "Limit risk per trade to 1-2% of your account"
RISK_PER_TRADE_PCT=0.01

# Tamanho minimo da posicao em USD
MIN_POSITION_USD=10.0

# Tamanho maximo da posicao como % do balance (default 10%)
MAX_POSITION_PCT=0.10

# Maximo de posicoes abertas simultaneas
MAX_OPEN_POSITIONS=1

# Break-Even: multiplo de ATR para ativar (move SL para preco de entrada)
BE_TRIGGER_ATR_MULT=1.0

# Trailing Stop: multiplo de ATR para distancia do trailing
TRAILING_ATR_MULT=1.5

# Partial TP: percentual da posicao fechada no TP1 (50%)
PARTIAL_TP_PCT=0.50

# ============================================================
# EXCHANGE EXECUTOR (v3.0) — Execucao de Ordens
# ============================================================

# True = simulacao (padrao seguro). False = envia ordens reais.
# SEMPRE comece com true. Altere via painel web quando pronto.
EXCHANGE_DRY_RUN=true

# Tipo de ordem: "market" ou "limit"
EXCHANGE_ORDER_TYPE=market

# Slippage estimado em % (usado para calculos de PnL)
EXCHANGE_SLIPPAGE_PCT=0.05

# ============================================================
# MULTI-TIMEFRAME FILTER (v3.0) — Confirmacao H4/D1
# ============================================================

# Filtro MTF ativo (verifica tendencia em H4 e D1 antes de sinal)
MULTITF_ENABLED=true

# Cache TTL em segundos (H4 candle = 4h, 15min e seguro)
MULTITF_CACHE_TTL=900

# ============================================================
# OPTIMIZER (v3.0) — Otimizacao de Parametros
# ============================================================

# Maximo de combinacoes para avaliar no grid search
OPTIMIZER_MAX_COMBOS=500

# Dias de dados para otimizacao (default 180)
OPTIMIZER_DEFAULT_DAYS=180
